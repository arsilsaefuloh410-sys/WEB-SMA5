# Tolak akses HTTP langsung ke berkas materi.
# Akses hanya melalui guru/unduh.php (unduh) dan guru/preview.php (pratinjau)
# yang memverifikasi sesi login terlebih dahulu.

# Apache 2.4
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
# Fallback Apache 2.2
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
