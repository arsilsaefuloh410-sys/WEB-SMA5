# ==========================================================
# Konfigurasi Aplikasi - Salin ke .env lalu sesuaikan
# ==========================================================
# Jangan commit berkas .env asli ke repository Git.

DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=db_bahan_ajar_informatika
DB_PORT=3306

# ==========================================================
# Pengaturan Email (untuk fitur Lupa Kata Sandi)
# Isi MAIL_USERNAME dan MAIL_PASSWORD (App Password untuk Gmail).
# APP_DEBUG=true menampilkan link reset langsung di layar
# jika pengiriman email gagal. HANYA untuk pengembangan —
# selalu false pada lingkungan produksi.
# ==========================================================
APP_DEBUG=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@sma5.sch.id
MAIL_FROM_NAME="Portal Bahan Ajar Informatika SMAN 5"
